---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/furniture', label: 'Furniture' },
  { href: '/nursery', label: 'Nursery' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-nav">
  <div class="container flex items-center justify-between h-16 px-6">
    <a href="/" class="flex items-center gap-2.5 font-bold text-lg tracking-tight">
      <span class="w-8 h-8 rounded-md bg-accent flex items-center justify-center text-bg font-bold text-sm">E</span>
      <span>Eebs Group</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
            currentPath === href
              ? 'text-accent bg-accent/8'
              : 'text-text-muted hover:text-text hover:bg-white/[0.04]'
          }`}
        >
          {label}
        </a>
      ))}
      <a href="/contact" class="btn-primary ml-3 text-sm py-2 px-4">
        Get in Touch
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Menu"
    >
      <span class="block w-5 h-0.5 bg-text rounded transition-transform" />
      <span class="block w-5 h-0.5 bg-text rounded transition-opacity" />
      <span class="block w-5 h-0.5 bg-text rounded transition-transform" />
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-bg/95 backdrop-blur-xl">
    <div class="container px-6 py-4 flex flex-col gap-1">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={`px-4 py-3 rounded-lg text-sm font-medium ${
            currentPath === href
              ? 'text-accent bg-accent/8'
              : 'text-text-muted hover:text-text'
          }`}
        >
          {label}
        </a>
      ))}
      <a href="/contact" class="btn-primary text-center justify-center mt-2">
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const spans = btn?.querySelectorAll('span');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    if (!open) {
      spans?.[0]?.classList.add('rotate-45', 'translate-y-[5px]');
      spans?.[1]?.classList.add('opacity-0');
      spans?.[2]?.classList.add('-rotate-45', '-translate-y-[5px]');
    } else {
      spans?.forEach(s => s.className = 'block w-5 h-0.5 bg-text rounded transition-transform');
    }
  });
</script>
